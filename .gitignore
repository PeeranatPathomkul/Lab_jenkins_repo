# Repository-wide ignores.
# Flutter-specific rules live in frontend/.gitignore
# Node/NestJS-specific rules live in backend/.gitignore

.DS_Store
*.log
.claude/
*.docx
.env

# Cosign signing key (Lab 06) lives only in Jenkins credentials — never commit
# it. The public half, cosign.pub, is committed for verification.
cosign.key
# Generated by the Generate SBOM stage.
/sbom/

# Stray Flutter scaffold accidentally generated at repo root (should only
# ever exist under frontend/ — see frontend/.gitignore for the real rules).
/android/
/ios/
/build/
/.dart_tool/
/.flutter-plugins-dependencies

docs/
